# EXAMPLE ONLY. Review paths/account/limits locally; nothing installs this unit.
# Pre-create /home/swarm/runtime-state as swarm, mode 0700. No hardware access.
[Unit]
Description=Operator-approved swarm application (hardware disabled)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=swarm
Group=swarm
UMask=0077
WorkingDirectory=/home/swarm
ExecStart=/home/swarm/deploy-venv/bin/python -m swarm.deploy launch --root /home/swarm/application-state --node-id pi-01 --identity-dir /home/swarm/identity
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/swarm/identity /home/swarm/application-state
ReadWritePaths=/home/swarm/runtime-state
# Runtime only needs TLS credentials, never the bundle decryption private key.
InaccessiblePaths=/home/swarm/identity/encryption-key.pem
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target