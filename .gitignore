# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
# native interpreter for arena training on Windows on ARM (python dev.py native-python)
.native-python/
.native-python.tmp/
dist/

# C++ / CMake
build/
build-*/
CMakeUserPresets.json
compile_commands.json

# Trained artifacts (regenerate with `python -m swarm.train.train_tiny_cnn`)
models/*.swm
models/*.npz
# compiled example networks (regenerate with the package's train.py or COMPILE in the studio)
examples/brains/*/model.swm

# Packages uploaded in the studio / created with `python -m swarm.sdk new` (keep yours in your own repo)
brains/*
!brains/README.md

# Sim / stress outputs
out/

# Local provisioning material / encrypted deployment artifacts (never commit keys)
.swarm-local/
authority/
identity/
credentials/
prepared-device/
*.swarmbundle
*.pem
*.key
*.p12
*.pfx

# Editors / OS
.idea/
*.swp
.DS_Store
Thumbs.db
